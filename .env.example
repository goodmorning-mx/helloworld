# GoodMorning MVP Template environment contract
# Safe placeholders only. Do not commit real secrets or Coolify-generated identifiers.

# -----------------------------------------------------------------------------
# Frontend Application build-time variable
# -----------------------------------------------------------------------------
# Used by Vite during `npm run build`. In Coolify, set this only on the
# Frontend Application as a build variable. Changing it requires rebuilding the
# frontend image. Never put DATABASE_URL in the frontend or frontend build.
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend Application runtime variables
# -----------------------------------------------------------------------------
# Set these only on the Backend Application runtime environment in Coolify.
APP_NAME=helloworld API
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
JWT_SECRET=local-only-change-this-secret-helloworld-32
OPENAI_API_KEY=
PRODUCT_ID=helloworld
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_ACCOUNT_MONITOR_ENABLED=true
BINANCE_REAL_TRADING_ENABLED=false
PRODUCTION_WORKER_ENABLED=true
PRODUCTION_WORKER_LIVE_ENABLED=false
PRODUCTION_WORKER_RESUME_LIVE=false
# Generate a persistent Fernet key for the backend; never expose it to the frontend.
BINANCE_CREDENTIALS_ENCRYPTION_KEY=
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_DELAY=0.25
# Automatic operation/state pushes are off by default. Telegram replies are sent only to commands.
TELEGRAM_SIGNAL_NOTIFICATIONS_ENABLED=false
# The command client is a single long-polling task; commands are accepted only from the allowlisted sender in the configured chat.
TELEGRAM_COMMANDS_ENABLED=false
# Internal authenticated owner ID whose Paper workers Telegram may control. Store as a managed secret remotely.
TELEGRAM_COMMAND_USER_ID=
# Telegram sender ID allowed to issue commands from the configured chat. Store as a managed secret remotely.
TELEGRAM_COMMAND_SENDER_ID=
CTRADER_ENABLED=false
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CTRADER_SYMBOLS=AUDUSD,XAUUSD,XAGUSD
# Secret runtime value for the backend. Remote deployments must use
# postgresql+psycopg:// after Factory converts only the initial postgresql://
# scheme from Coolify, preserving all credentials, host, port, database, query
# string, and URL-encoded characters unchanged.
DATABASE_URL=postgresql+psycopg://goodmorning:goodmorning_local_password@postgres:5432/goodmorning_mvp

# -----------------------------------------------------------------------------
# Local Docker Compose only
# -----------------------------------------------------------------------------
# Used by the local postgres service. Do not copy these as frontend/backend
# Coolify variables unless a specific resource explicitly requires them.
POSTGRES_DB=goodmorning_mvp
POSTGRES_USER=goodmorning
POSTGRES_PASSWORD=goodmorning_local_password
